{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" = true ] && [ ! -d \"$CLAUDE_PROJECT_DIR/node_modules/jsdom\" ] && cd \"$CLAUDE_PROJECT_DIR\" && npm install --no-audit --no-fund --silent > /dev/null 2>&1; exit 0"
          }
